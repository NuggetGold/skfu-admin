<UserControl x:Class="SkfuAdmin.Views.ScheduleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><TabControl>
  <TabItem Header="Расписание"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Режим:" VerticalAlignment="Center"/><ComboBox x:Name="ModeBox" Width="130" SelectionChanged="SelectionChanged"/><ComboBox x:Name="EntityBox" Width="300" SelectionChanged="SelectionChanged"/><TextBlock Text="Неделя:" VerticalAlignment="Center"/><ComboBox x:Name="ParityBox" Width="130" SelectionChanged="SelectionChanged"/><Button Content="Обновить" Click="RefreshClick"/><Button Content="Добавить занятие" Click="AddClick"/><Button x:Name="DeleteButton" Content="Удалить занятие" Click="DeleteClick" IsEnabled="False"/><Button Content="Экспорт CSV" Click="ExportClick"/></WrapPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="WeekGrid" Margin="0,12"/></ScrollViewer></Grid></TabItem>
  <TabItem Header="Свободные аудитории"><StackPanel Margin="10"><WrapPanel><TextBlock Text="День:"/><ComboBox x:Name="FreeDay" Width="120"/><TextBlock Text="Пара:"/><ComboBox x:Name="FreeSlot" Width="180"/><TextBlock Text="Мин. мест:"/><TextBox x:Name="FreeCapacity" Width="70" Text="0"/><TextBlock Text="Корпус:"/><ComboBox x:Name="FreeBuilding" Width="180"/><TextBlock Text="Тип:"/><ComboBox x:Name="FreeKind" Width="170"/><TextBlock Text="Неделя:"/><ComboBox x:Name="FreeParity" Width="120"/><Button Content="Найти" Click="FreeClick"/></WrapPanel><DataGrid x:Name="FreeGrid" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,12"/></StackPanel></TabItem>
  <TabItem Header="Загрузка аудиторий"><StackPanel Margin="10"><WrapPanel><TextBlock Text="Корпус:"/><ComboBox x:Name="LoadBuilding" Width="220"/><TextBlock Text="Неделя:"/><ComboBox x:Name="LoadParity" Width="130"/><Button Content="Показать загрузку" Click="LoadClick"/></WrapPanel><DataGrid x:Name="LoadGrid" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,12"/></StackPanel></TabItem>
 </TabControl></Grid>
</UserControl>
