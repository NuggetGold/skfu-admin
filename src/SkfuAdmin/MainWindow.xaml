<Window x:Class="SkfuAdmin.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:data="clr-namespace:SkfuAdmin.Data" xmlns:infra="clr-namespace:SkfuAdmin.Infrastructure" xmlns:views="clr-namespace:SkfuAdmin.Views" Title="СКФУ — Техническое администрирование" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVis"/><infra:StringNotEmptyVisibilityConverter x:Key="TextVis"/><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="6"/></Style></Window.Resources>
 <Window.InputBindings><KeyBinding Key="K" Modifiers="Control" Command="{Binding SearchCommand}"/><KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}"/></Window.InputBindings>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="16">
   <StackPanel DockPanel.Dock="Top"><Border Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="СКФУ" FontSize="26" FontWeight="Bold"/><TextBlock Text="Северо-Кавказский&#x0a;федеральный университет"/><TextBlock Text="Техническое администрирование" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" FontSize="11"/></StackPanel></Border>
    <Button Content="⌂  Обзор" Command="{Binding NavigateCommand}" CommandParameter="Обзор"/><Button Content="▦  Структура" Command="{Binding NavigateCommand}" CommandParameter="Структура"/><Button Content="♙  Контингент" Command="{Binding NavigateCommand}" CommandParameter="Контингент"/><Button Content="▤  Учебный процесс" Command="{Binding NavigateCommand}" CommandParameter="Учебный процесс"/><Button Content="▧  Расписание" Command="{Binding NavigateCommand}" CommandParameter="Расписание"/><Button Content="✓  Качество данных" Command="{Binding NavigateCommand}" CommandParameter="Качество данных"/><Button Content="≡  Журнал действий" Command="{Binding NavigateCommand}" CommandParameter="Журнал действий"/><Button Content="⚙  Система" Command="{Binding NavigateCommand}" CommandParameter="Система"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Button Content="{Binding ThemeTitle}" Command="{Binding ToggleThemeCommand}"/><TextBlock Text="14 октября 2026" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="{Binding Section}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Поиск  Ctrl+K" Command="{Binding SearchCommand}"/><Button Content="↻ Обновить" Command="{Binding RefreshCommand}"/><Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="9,5" Margin="8,3"><TextBlock Text="● База данных подключена"/></Border></StackPanel></DockPanel>
   <Grid Grid.Row="1">
    <ScrollViewer Visibility="{Binding IsDashboard, Converter={StaticResource BoolVis}}"><StackPanel><UniformGrid Columns="3" Margin="0,0,0,18"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Студенты" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Stats.Students}" FontSize="30"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Группы" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Stats.Groups}" FontSize="30"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Преподаватели" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Stats.Teachers}" FontSize="30"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Аудитории" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Stats.Rooms}" FontSize="30"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Занятия" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Stats.ScheduleEntries}" FontSize="30"/></StackPanel></Border><Button Content="Проблемы" Command="{Binding NavigateCommand}" CommandParameter="Качество данных" Background="{DynamicResource DangerBrush}"/></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="Занятия по дням" FontSize="17"/><ItemsControl ItemsSource="{Binding Stats.LoadByWeekday}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,8"><TextBlock Text="{Binding Label}" Width="30"/><ProgressBar Value="{Binding Value}" Maximum="20" Height="12"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Text="Контингент по институтам" FontSize="17"/><ItemsControl ItemsSource="{Binding Stats.StudentsByInstitute}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,8"><TextBlock Text="{Binding Label}" Width="220" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Value}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid></StackPanel></ScrollViewer>
     <Grid Visibility="{Binding IsTable, Converter={StaticResource BoolVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding Table}" DisplayMemberPath="Title" Width="300" HorizontalAlignment="Left"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}" Width="220"/><Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}"/><Button Content="Сохранить представление" Command="{Binding SaveViewCommand}"/><Button Content="Представления" Command="{Binding OpenViewsCommand}"/><Button Content="Добавить" Command="{Binding AddCommand}"/><Button Content="Изменить" Command="{Binding EditCommand}"/><Button Content="Удалить" Command="{Binding DeleteCommand}"/><Button Content="Экспорт CSV" Command="{Binding ExportCommand}"/><Button Content="Импорт CSV" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"/></StackPanel><ItemsControl Grid.Row="2" ItemsSource="{Binding TableFilters}" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,12,4"><TextBlock Text="{Binding Title}"/><ComboBox ItemsSource="{Binding Values}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" Width="180"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Visibility="{Binding CanShowBulkActions, Converter={StaticResource BoolVis}}"><Button Content="Массовое изменение" Command="{Binding MassUpdateCommand}"/><Button Content="Удалить выбранные" Command="{Binding DeleteManyCommand}"/></StackPanel><DataGrid x:Name="TableGrid" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" Margin="0,0,0,10" MouseDoubleClick="TableGridDoubleClick" Sorting="TableGridSorting" SelectionChanged="TableGridSelectionChanged"/></Grid><DockPanel Grid.Row="4"><TextBlock Text="{Binding PageText}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="← Назад" Command="{Binding PreviousPageCommand}"/><Button Content="Вперёд →" Command="{Binding NextPageCommand}"/></StackPanel></DockPanel></Grid>
    <Grid Visibility="{Binding IsIntegrity, Converter={StaticResource BoolVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Найдены реальные нарушения, рассчитанные по текущей базе." Foreground="{DynamicResource MutedBrush}"/><Button DockPanel.Dock="Right" Content="Проверить снова" Command="{Binding CheckIntegrityCommand}"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Integrity}" SelectedItem="{Binding SelectedIntegrity}" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="IntegritySelectionChanged"/><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="Детали правила" FontSize="18" Margin="0,0,0,8"/><DataGrid ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="True" IsReadOnly="True"/><Button Content="Перейти к записи" Click="OpenIssueClick" HorizontalAlignment="Left"/></StackPanel></Grid></Grid>
    <Grid Visibility="{Binding IsSystem, Converter={StaticResource BoolVis}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding DbStats.TotalRows, StringFormat=Всего записей: {0}}" FontSize="20"/><TextBlock Text="{Binding DbStats.FileSize, StringFormat=Размер базы: {0} байт}"/><TextBlock Text="{Binding Source={x:Static data:Db.Path}, StringFormat=Путь: {0}}"/></StackPanel><StackPanel Grid.Row="1"><StackPanel Orientation="Horizontal"><Button Content="Создать резервную копию" Command="{Binding CreateBackupCommand}"/><Button Content="Проверить целостность и оптимизировать" Command="{Binding OptimizeCommand}"/><Button Content="Восстановить из файла" Click="RestoreClick"/></StackPanel><TextBlock Text="Резервные копии" FontSize="18" Margin="0,14,0,5"/><DataGrid ItemsSource="{Binding Backups}" AutoGenerateColumns="True" IsReadOnly="True"/></StackPanel></Grid>
    <views:AuditView x:Name="AuditControl" Visibility="{Binding IsAudit, Converter={StaticResource BoolVis}}"/>
    <views:ScheduleView x:Name="ScheduleControl" Visibility="{Binding IsSchedule, Converter={StaticResource BoolVis}}"/>
   </Grid>
  </Grid>
  <Border Grid.ColumnSpan="2" Visibility="{Binding SearchOpen, Converter={StaticResource BoolVis}}" Background="#B8000000"><Border Background="{DynamicResource PanelBrush}" Width="680" VerticalAlignment="Top" Margin="0,100,0,0" Padding="22" CornerRadius="12"><StackPanel><DockPanel><TextBlock Text="Глобальный поиск" FontSize="20"/><Button DockPanel.Dock="Right" Content="Закрыть" Command="{Binding CloseSearchCommand}"/></DockPanel><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,12"/><StackPanel Orientation="Horizontal"><Button Content="Перейти к расписанию" Command="{Binding NavigateCommand}" CommandParameter="Расписание"/><Button Content="Сменить тему" Command="{Binding ToggleThemeCommand}"/></StackPanel><ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearch}" MouseDoubleClick="SearchResultDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></Border>
  <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="14,8" Margin="28" Visibility="{Binding Toast, Converter={StaticResource TextVis}}"><TextBlock Text="{Binding Toast}"/></Border>
 </Grid>
</Window>

